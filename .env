# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=PLACEHOLDER_SECRET

# ── GitHub OAuth ───────────────────────────────────────────────────────────────
GITHUB_ID=PLACEHOLDER_GITHUB_ID
GITHUB_SECRET=PLACEHOLDER_GITHUB_SECRET

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/travel-planner

# ── Google Gemini ──────────────────────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=PLACEHOLDER_GEMINI_KEY

# ── Groq ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=PLACEHOLDER_GROQ_KEY

# ── OpenWeatherMap ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_OPENWEATHER_API_KEY=PLACEHOLDER_WEATHER_KEY

# ── Unsplash ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=PLACEHOLDER_UNSPLASH_KEY
