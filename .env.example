# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# ── GitHub OAuth ───────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers -> New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=your_github_oauth_app_id
GITHUB_SECRET=your_github_oauth_app_secret

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Get free cluster at: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/travel-planner

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Get key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# ── Groq ───────────────────────────────────────────────────────────────────────
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# ── OpenWeatherMap ─────────────────────────────────────────────────────────────
# Get free key at: https://openweathermap.org/api
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key

# ── Unsplash ───────────────────────────────────────────────────────────────────
# Get key at: https://unsplash.com/developers -> New Application
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=your_unsplash_access_key
